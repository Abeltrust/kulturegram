APP_NAME=Kulturegram
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kulturegram
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@kulturegram.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# META GLOBAL AI DEVELOPER HACKATHON CONFIGURATION
# -----------------------------------------------------------------------------
# Core requirement: ONE shared Meta Model API key for every compatible hosted
# Meta model (Muse Spark, Muse Wonder, Muse Image, Muse Voice Transcribe, SAM 3.1).
# -----------------------------------------------------------------------------
META_MODEL_API_KEY= LLM_1101281142519696_joE36oxglRk-knIQ6cQQJE88wwA
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_TIMEOUT=45
META_MODEL_API_CONNECT_TIMEOUT=10

# Individual model identifiers (configured separately, sharing one key)
META_MUSE_SPARK_MODEL=muse-spark
META_MUSE_WONDER_MODEL=muse-wonder
META_MUSE_IMAGE_MODEL=muse-image
META_VOICE_TRANSCRIBE_MODEL=muse-voice-transcribe
META_SAM_MODEL=sam-3.1

# -----------------------------------------------------------------------------
# OPEN-WEIGHT INFERENCE PROVIDER (Configured independently from hosted key)
# -----------------------------------------------------------------------------
# Muse Glimmer and Muse Spark Open can be hosted locally or via third-party providers
# (vLLM, Ollama, HuggingFace Inference Endpoints, Together AI, etc.).
# -----------------------------------------------------------------------------
META_OPEN_WEIGHT_PROVIDER=

META_GLIMMER_ENDPOINT=
META_GLIMMER_API_KEY=
META_GLIMMER_MODEL=meta-models/muse-glimmer-8b

META_SPARK_OPEN_ENDPOINT=
META_SPARK_OPEN_API_KEY=
META_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
